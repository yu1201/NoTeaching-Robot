ROUTINE WriteCurrentPulse(ch : FILE; axis_count : INTEGER)
VAR
  jpos : JOINTPOS
  vals : ARRAY[9] OF REAL
BEGIN
  vals[1] = 0.0
  vals[2] = 0.0
  vals[3] = 0.0
  vals[4] = 0.0
  vals[5] = 0.0
  vals[6] = 0.0

  jpos = CURJPOS(0,0)
  CNV_JPOS_REL(jpos, vals, g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_PULSE_FAIL')
    RETURN
  ENDIF

  IF axis_count <= 6 THEN
    WRITE ch('PULSE:',
             vals[1]::10::3, ',',
             vals[2]::10::3, ',',
             vals[3]::10::3, ',',
             vals[4]::10::3, ',',
             vals[5]::10::3, ',',
             vals[6]::10::3, ',',
             0.0::10::3, ',',
             0.0::10::3, ',',
             0.0::10::3, CR)
    RETURN
  ENDIF

  IF axis_count = 7 THEN
    WRITE ch('PULSE:',
             vals[1]::10::3, ',',
             vals[2]::10::3, ',',
             vals[3]::10::3, ',',
             vals[4]::10::3, ',',
             vals[5]::10::3, ',',
             vals[6]::10::3, ',',
             vals[7]::10::3, ',',
             0.0::10::3, ',',
             0.0::10::3, CR)
    RETURN
  ENDIF

  IF axis_count = 8 THEN
    WRITE ch('PULSE:',
             vals[1]::10::3, ',',
             vals[2]::10::3, ',',
             vals[3]::10::3, ',',
             vals[4]::10::3, ',',
             vals[5]::10::3, ',',
             vals[6]::10::3, ',',
             vals[7]::10::3, ',',
             vals[8]::10::3, ',',
             0.0::10::3, CR)
    RETURN
  ENDIF

  WRITE ch('PULSE:',
           vals[1]::10::3, ',',
           vals[2]::10::3, ',',
           vals[3]::10::3, ',',
           vals[4]::10::3, ',',
           vals[5]::10::3, ',',
           vals[6]::10::3, ',',
           vals[7]::10::3, ',',
           vals[8]::10::3, ',',
           vals[9]::10::3, CR)
END WriteCurrentPulse

ROUTINE WriteDoneState(ch : FILE)
VAR
  moving : BOOLEAN
  task_name : STRING[36]
  task_no : INTEGER
  task_status : INTEGER
  task_dummy : STRING[2]
  task_query_status : INTEGER
BEGIN
  GET_VAR(g_entry, '*SYSTEM*', '$MOR_GRP[1].$ROB_MOVE', moving, g_status)
  IF g_status = 0 THEN
    IF moving THEN
      WRITE ch('DONE:0', CR)
    ELSE
      IF g_active_task_name = '' THEN
        WRITE ch('DONE:1', CR)
        RETURN
      ENDIF

      -- ROB_MOVE=FALSE 只表示采样瞬间没有轴运动；任务仍可能处于等待、暂停、
      -- 接受或减速中。只有任务查询明确到达 PG_ABORTED 才能释放高层租约。
      task_name = g_active_task_name
      task_no = 0
      GET_TSK_INFO(task_name, task_no, TSK_STATUS,
                   task_status, task_dummy, task_query_status)
      IF task_query_status <> 0 THEN
        WRITE ch('DONE:-1', CR)
        RETURN
      ENDIF
      IF task_status = PG_ABORTED THEN
        ClearActiveTask
        WRITE ch('DONE:1', CR)
      ELSE
        WRITE ch('DONE:0', CR)
      ENDIF
    ENDIF
  ELSE
    WRITE ch('DONE:-1', CR)
  ENDIF
END WriteDoneState

ROUTINE FindChar(src : STRING; token : STRING) : INTEGER
VAR
  i   : INTEGER
  one : STRING[1]
BEGIN
  FOR i = 1 TO STR_LEN(src) DO
    one = SUB_STR(src, i, 1)
    IF one = token THEN
      RETURN(i)
    ENDIF
  ENDFOR
  RETURN(0)
END FindChar

ROUTINE Payload(cmd : STRING; prefix_len : INTEGER; out_str : STRING)
BEGIN
  out_str = SUB_STR(cmd, prefix_len + 1, STR_LEN(cmd) - prefix_len)
END Payload

ROUTINE DoSetInt(ch : FILE; cmd : STRING)
VAR
  comma_pos : INTEGER
  reg_name  : STRING[64]
  reg_value : STRING[64]
  reg_index : INTEGER
BEGIN
  Payload(cmd, 8, g_text1)
  comma_pos = FindChar(g_text1, ',')
  IF comma_pos <= 1 THEN
    WriteErr(ch, 'BAD_SET_INT')
    RETURN
  ENDIF

  reg_name = SUB_STR(g_text1, 1, comma_pos - 1)
  reg_value = SUB_STR(g_text1, comma_pos + 1, STR_LEN(g_text1) - comma_pos)

  IF SUB_STR(reg_name, 1, 3) = 'INT' THEN
    CNV_STR_INT(SUB_STR(reg_name, 4, STR_LEN(reg_name) - 3), reg_index)
  ELSE
    IF reg_name = 'WELD_TRACK_NO' THEN
      reg_index = 30
    ELSE
      WriteErr(ch, 'UNSUPPORTED_INT_NAME')
      RETURN
    ENDIF
  ENDIF

  CNV_STR_INT(reg_value, g_int)
  SET_INT_REG(reg_index, g_int, g_status)
  IF g_status = 0 THEN
    WriteOk(ch, '')
  ELSE
    WriteErr(ch, 'SET_INT_FAIL')
  ENDIF
END DoSetInt

ROUTINE DoGetInt(ch : FILE; cmd : STRING)
VAR
  comma_pos : INTEGER
  reg_type  : STRING[16]
  reg_index : INTEGER
BEGIN
  Payload(cmd, 8, g_text1)
  comma_pos = FindChar(g_text1, ',')
  IF comma_pos <= 0 THEN
    WriteErr(ch, 'BAD_GET_INT')
    RETURN
  ENDIF

  reg_type = SUB_STR(g_text1, 1, comma_pos - 1)
  IF reg_type <> 'INT' THEN
    WriteErr(ch, 'UNSUPPORTED_GET_INT')
    RETURN
  ENDIF

  CNV_STR_INT(SUB_STR(g_text1, comma_pos + 1, STR_LEN(g_text1) - comma_pos), reg_index)
  GET_REG(reg_index, g_bool, g_int, g_real, g_status)
  IF g_status = 0 THEN
    IF g_bool THEN
      WRITE ch('INT:', g_real::10::3, CR)
    ELSE
      WRITE ch('INT:', g_int, CR)
    ENDIF
  ELSE
    WriteErr(ch, 'GET_INT_FAIL')
  ENDIF
END DoGetInt

ROUTINE DoCallJob(ch : FILE; cmd : STRING)
BEGIN
  Payload(cmd, 9, g_text1)
  -- 先把被动完成寄存器置为运行态，再接受任务；这样 S5 不会在 RUN_TASK
  -- 已接受但 g_active_task_name 尚未写入的窗口误报完成。
  SET_INT_REG(98, 0, g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'CALL_JOB_STATE_FAIL')
    RETURN
  ENDIF
  RUN_TASK(g_text1, 1, FALSE, FALSE, 1, g_status)
  IF g_status = 0 THEN
    g_active_task_name = g_text1
    WriteOk(ch, '')
  ELSE
    ClearActiveTask
    WriteErr(ch, 'CALL_JOB_FAIL')
  ENDIF
END DoCallJob

ROUTINE DoProgramStop(ch : FILE)
VAR
  task_name : STRING[36]
  abort_status : INTEGER
  task_no : INTEGER
  task_status : INTEGER
  task_dummy : STRING[2]
  task_query_status : INTEGER
BEGIN
  task_name = g_active_task_name
  IF task_name = '' THEN
    WriteErr(ch, 'NO_ACTIVE_CALL_JOB')
    RETURN
  ENDIF

  -- 任务可能刚好在用户按 STOP 前自然结束。先确认终态，避免对已经
  -- PG_ABORTED 的任务再次 ABORT_TASK 返回错误并留下无法解除的闭锁。
  task_no = 0
  GET_TSK_INFO(task_name, task_no, TSK_STATUS,
               task_status, task_dummy, task_query_status)
  IF (task_query_status = 0) AND (task_status = PG_ABORTED) THEN
    ClearActiveTask
    WriteOk(ch, 'ALREADY_STOPPED')
    RETURN
  ENDIF

  -- force_sw=TRUE：即使目标任务设置 ignore-abort 也中止；
  -- cancel_mtn_sw=TRUE：同步取消该任务所属运动组的当前/排队运动。
  ABORT_TASK(task_name, TRUE, TRUE, abort_status)
  IF abort_status = 0 THEN
    -- ABORT_TASK 成功只代表中止请求被接受；ABORTING/减速期间继续保持
    -- active name 和 R[98]=0，由 WriteDoneState 的 PG_ABORTED 回读最终清除。
    WriteOk(ch, 'ABORT_REQUESTED')
  ELSE
    WriteErr(ch, 'PROGRAM_STOP_FAIL')
  ENDIF
END DoProgramStop

ROUTINE WriteActiveTask(ch : FILE)
VAR
  task_name : STRING[36]
  task_no : INTEGER
  task_status : INTEGER
  task_line : INTEGER
  task_dummy : STRING[2]
  query_status : INTEGER
BEGIN
  task_name = g_active_task_name
  IF task_name = '' THEN
    WRITE ch('TASK:NONE,', PG_ABORTED, ',0', CR)
    RETURN
  ENDIF

  task_no = 0
  GET_TSK_INFO(task_name, task_no, TSK_STATUS,
               task_status, task_dummy, query_status)
  IF query_status <> 0 THEN
    WriteErr(ch, 'TASK_STATUS_QUERY_FAIL')
    RETURN
  ENDIF

  task_no = 0
  GET_TSK_INFO(task_name, task_no, TSK_LINENUM,
               task_line, task_dummy, query_status)
  IF query_status <> 0 THEN
    WriteErr(ch, 'TASK_LINE_QUERY_FAIL')
    RETURN
  ENDIF

  WRITE ch('TASK:', task_name, ',', task_status, ',', task_line, CR)
END WriteActiveTask

ROUTINE DoPauseTask(ch : FILE; cmd : STRING)
VAR
  task_name : STRING[36]
  task_no : INTEGER
  task_status : INTEGER
  task_line : INTEGER
  task_dummy : STRING[2]
  query_status : INTEGER
  pause_status : INTEGER
  retry : INTEGER
BEGIN
  Payload(cmd, 11, task_name)
  IF (task_name = '') OR (task_name <> g_active_task_name) THEN
    WriteErr(ch, 'PAUSE_TASK_IDENTITY_MISMATCH')
    RETURN
  ENDIF

  task_no = 0
  GET_TSK_INFO(task_name, task_no, TSK_STATUS,
               task_status, task_dummy, query_status)
  IF query_status <> 0 THEN
    WriteErr(ch, 'PAUSE_TASK_STATUS_QUERY_FAIL')
    RETURN
  ENDIF

  IF task_status <> PG_PAUSED THEN
    IF (task_status <> PG_RUNNING) AND (task_status <> PG_RUNACCEPT) THEN
      WriteErr(ch, 'PAUSE_TASK_NOT_RUNNING')
      RETURN
    ENDIF
    PAUSE_TASK(task_name, TRUE, TRUE, pause_status)
    IF pause_status <> 0 THEN
      WriteErr(ch, 'PAUSE_TASK_FAIL')
      RETURN
    ENDIF
  ENDIF

  FOR retry = 1 TO 30 DO
    task_no = 0
    GET_TSK_INFO(task_name, task_no, TSK_STATUS,
                 task_status, task_dummy, query_status)
    IF (query_status = 0) AND (task_status = PG_PAUSED) THEN
      task_no = 0
      GET_TSK_INFO(task_name, task_no, TSK_LINENUM,
                   task_line, task_dummy, query_status)
      IF query_status = 0 THEN
        WRITE ch('PAUSED:', task_name, ',', task_line, CR)
        RETURN
      ENDIF
    ENDIF
    DELAY(50)
  ENDFOR
  WriteErr(ch, 'PAUSE_TASK_VERIFY_TIMEOUT')
END DoPauseTask

ROUTINE DoResumeTask(ch : FILE; cmd : STRING)
VAR
  task_name : STRING[36]
  task_no : INTEGER
  task_status : INTEGER
  task_dummy : STRING[2]
  query_status : INTEGER
  continue_status : INTEGER
  retry : INTEGER
BEGIN
  Payload(cmd, 12, task_name)
  IF (task_name = '') OR (task_name <> g_active_task_name) THEN
    WriteErr(ch, 'RESUME_TASK_IDENTITY_MISMATCH')
    RETURN
  ENDIF

  task_no = 0
  GET_TSK_INFO(task_name, task_no, TSK_STATUS,
               task_status, task_dummy, query_status)
  IF (query_status <> 0) OR (task_status <> PG_PAUSED) THEN
    WriteErr(ch, 'RESUME_TASK_NOT_PAUSED')
    RETURN
  ENDIF

  CONT_TASK(task_name, continue_status)
  IF continue_status <> 0 THEN
    WriteErr(ch, 'RESUME_TASK_FAIL')
    RETURN
  ENDIF

  FOR retry = 1 TO 20 DO
    task_no = 0
    GET_TSK_INFO(task_name, task_no, TSK_STATUS,
                 task_status, task_dummy, query_status)
    IF (query_status = 0) AND
       ((task_status = PG_RUNNING) OR (task_status = PG_RUNACCEPT)) THEN
      WRITE ch('RESUMED:', task_name, ',', task_status, CR)
      RETURN
    ENDIF
    DELAY(50)
  ENDFOR
  WriteErr(ch, 'RESUME_TASK_VERIFY_TIMEOUT')
END DoResumeTask

ROUTINE DoSetReal(ch : FILE; cmd : STRING)
VAR
  comma_pos : INTEGER
  reg_name : STRING[64]
  reg_value : STRING[64]
  reg_index : INTEGER
BEGIN
  Payload(cmd, 9, g_text1)
  comma_pos = FindChar(g_text1, ',')
  IF comma_pos <= 4 THEN
    WriteErr(ch, 'BAD_SET_REAL')
    RETURN
  ENDIF

  reg_name = SUB_STR(g_text1, 1, comma_pos - 1)
  reg_value = SUB_STR(g_text1, comma_pos + 1, STR_LEN(g_text1) - comma_pos)
  IF SUB_STR(reg_name, 1, 4) <> 'REAL' THEN
    WriteErr(ch, 'UNSUPPORTED_REAL_NAME')
    RETURN
  ENDIF
  CNV_STR_INT(SUB_STR(reg_name, 5, STR_LEN(reg_name) - 4), reg_index)
  CNV_STR_REAL(reg_value, g_real)
  SET_REAL_REG(reg_index, g_real, g_status)
  IF g_status = 0 THEN
    WriteOk(ch, '')
  ELSE
    WriteErr(ch, 'SET_REAL_FAIL')
  ENDIF
END DoSetReal

ROUTINE DoSetToolNo(ch : FILE; cmd : STRING)
VAR
  tool_no : INTEGER
  readback : INTEGER
BEGIN
  Payload(cmd, 12, g_text1)
  CNV_STR_INT(g_text1, tool_no)
  IF (tool_no < 1) OR (tool_no > 10) THEN
    WriteErr(ch, 'BAD_TOOL_NO')
    RETURN
  ENDIF

  g_entry = 0
  SET_VAR(g_entry, '*SYSTEM*', '$MNUTOOLNUM[1]', tool_no, g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'SET_TOOL_NO_FAIL')
    RETURN
  ENDIF
  g_entry = 0
  GET_VAR(g_entry, '*SYSTEM*', '$MNUTOOLNUM[1]', readback, g_status)
  IF (g_status <> 0) OR (readback <> tool_no) THEN
    WriteErr(ch, 'SET_TOOL_NO_VERIFY_FAIL')
    RETURN
  ENDIF
  WRITE ch('TOOL_NO:', readback, CR)
END DoSetToolNo

ROUTINE DoGetToolData(ch : FILE; cmd : STRING)
VAR
  tool_no : INTEGER
  tool_text : STRING[4]
  variable_name : STRING[64]
  values : ARRAY[6] OF REAL
BEGIN
  Payload(cmd, 14, g_text1)
  CNV_STR_INT(g_text1, tool_no)
  IF (tool_no < 1) OR (tool_no > 10) THEN
    WriteErr(ch, 'BAD_TOOL_NO')
    RETURN
  ENDIF
  CNV_INT_STR(tool_no, 0, 0, tool_text)

  variable_name = '$MNUTOOL[1,' + tool_text + '].$X'
  g_entry = 0
  GET_VAR(g_entry, '*SYSTEM*', variable_name, values[1], g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_TOOL_X_FAIL')
    RETURN
  ENDIF
  variable_name = '$MNUTOOL[1,' + tool_text + '].$Y'
  g_entry = 0
  GET_VAR(g_entry, '*SYSTEM*', variable_name, values[2], g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_TOOL_Y_FAIL')
    RETURN
  ENDIF
  variable_name = '$MNUTOOL[1,' + tool_text + '].$Z'
  g_entry = 0
  GET_VAR(g_entry, '*SYSTEM*', variable_name, values[3], g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_TOOL_Z_FAIL')
    RETURN
  ENDIF
  variable_name = '$MNUTOOL[1,' + tool_text + '].$W'
  g_entry = 0
  GET_VAR(g_entry, '*SYSTEM*', variable_name, values[4], g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_TOOL_W_FAIL')
    RETURN
  ENDIF
  variable_name = '$MNUTOOL[1,' + tool_text + '].$P'
  g_entry = 0
  GET_VAR(g_entry, '*SYSTEM*', variable_name, values[5], g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_TOOL_P_FAIL')
    RETURN
  ENDIF
  variable_name = '$MNUTOOL[1,' + tool_text + '].$R'
  g_entry = 0
  GET_VAR(g_entry, '*SYSTEM*', variable_name, values[6], g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_TOOL_R_FAIL')
    RETURN
  ENDIF

  WRITE ch('TOOL:',
           values[1]::10::3, ',', values[2]::10::3, ',',
           values[3]::10::3, ',', values[4]::10::3, ',',
           values[5]::10::3, ',', values[6]::10::3, CR)
END DoGetToolData

ROUTINE DoGetHandEyeMatrix(ch : FILE; cmd : STRING)
VAR
  matrix_name : STRING[32]
  values : ARRAY[12] OF REAL
  reg_no : INTEGER
  idx : INTEGER
  is_real : BOOLEAN
  int_value : INTEGER
  real_value : REAL
  reg_status : INTEGER
BEGIN
  Payload(cmd, 14, matrix_name)
  IF matrix_name <> 'eye' THEN
    WriteErr(ch, 'UNSUPPORTED_HE_MATRIX_NAME')
    RETURN
  ENDIF

  FOR idx = 1 TO 12 DO
    reg_no = 99 + idx
    GET_REG(reg_no, is_real, int_value, real_value, reg_status)
    IF reg_status <> 0 THEN
      WriteErr(ch, 'GET_HE_MATRIX_REG_FAIL')
      RETURN
    ENDIF
    IF is_real THEN
      values[idx] = real_value
    ELSE
      values[idx] = int_value
    ENDIF
  ENDFOR

  WRITE ch('HE_MATRIX:',
           values[1]::12::6, ',', values[2]::12::6, ',',
           values[3]::12::6, ',', values[4]::12::6, ',',
           values[5]::12::6, ',', values[6]::12::6, ',',
           values[7]::12::6, ',', values[8]::12::6, ',',
           values[9]::12::6, ',', values[10]::12::6, ',',
           values[11]::12::6, ',', values[12]::12::6, CR)
END DoGetHandEyeMatrix

ROUTINE DoSetTpSpeed(ch : FILE; cmd : STRING)
BEGIN
  Payload(cmd, 13, g_text1)
  CNV_STR_INT(g_text1, g_int)
  SET_INT_REG(17, g_int, g_status)
  IF g_status = 0 THEN
    WriteOk(ch, '')
  ELSE
    WriteErr(ch, 'SET_TP_SPEED_FAIL')
  ENDIF
END DoSetTpSpeed

ROUTINE DoStopService(ch : FILE)
BEGIN
  SET_INT_REG(99, 1, g_status)
  IF g_status = 0 THEN
    WriteOk(ch, 'STOPPING')
  ELSE
    WriteErr(ch, 'STOP_SERVICE_FAIL')
  ENDIF
END DoStopService

ROUTINE PopToken(rest : STRING; token : STRING)
VAR
  comma_pos : INTEGER
BEGIN
  comma_pos = FindChar(rest, ',')
  IF comma_pos <= 0 THEN
    token = rest
    rest = ''
  ELSE
    token = SUB_STR(rest, 1, comma_pos - 1)
    rest = SUB_STR(rest, comma_pos + 1, STR_LEN(rest) - comma_pos)
  ENDIF
END PopToken

ROUTINE DoSetPosVar(ch : FILE; cmd : STRING)
VAR
  cmd_body : STRING[254]
  token    : STRING[64]
  reg_no   : INTEGER
  pos_type : INTEGER
  idx      : INTEGER
  vals     : ARRAY[9] OF REAL
  xyz_pos  : XYZWPR
  jnt_pos  : JOINTPOS
  xyz_cfg  : CONFIG
BEGIN
  Payload(cmd, 12, cmd_body)

  PopToken(cmd_body, token)
  CNV_STR_INT(token, reg_no)
  PopToken(cmd_body, token)
  CNV_STR_INT(token, pos_type)

  FOR idx = 1 TO 9 DO
    vals[idx] = 0.0
  ENDFOR

  FOR idx = 1 TO 8 DO
    PopToken(cmd_body, token)
    CNV_STR_REAL(token, vals[idx])
  ENDFOR

  IF pos_type = 0 THEN
    xyz_pos = CURPOS(0, 0)
    xyz_pos.x = vals[1]
    xyz_pos.y = vals[2]
    xyz_pos.z = vals[3]
    xyz_pos.w = vals[4]
    xyz_pos.p = vals[5]
    xyz_pos.r = vals[6]
    CNV_STR_CONF('N U T, 0, 0, 0', xyz_cfg, g_status)
    IF g_status <> 0 THEN
      WriteErr(ch, 'BAD_CONFIG')
      RETURN
    ENDIF
    xyz_pos.config_data = xyz_cfg
    SET_POS_REG(reg_no, xyz_pos, g_status)
  ELSE
    CNV_REL_JPOS(vals, jnt_pos, g_status)
    IF g_status <> 0 THEN
      WriteErr(ch, 'BAD_JPOS')
      RETURN
    ENDIF
    SET_JPOS_REG(reg_no, jnt_pos, g_status)
  ENDIF

  IF g_status = 0 THEN
    WriteOk(ch, '')
  ELSE
    WriteErr(ch, 'SET_POS_VAR_FAIL')
  ENDIF
END DoSetPosVar

ROUTINE DoGetPosVar(ch : FILE; cmd : STRING)
VAR
  cmd_body : STRING[254]
  token    : STRING[64]
  reg_no   : INTEGER
  move_type : INTEGER
  pos_type : INTEGER
  num_axes : INTEGER
  pos      : XYZWPREXT
  cfg_text : STRING[32]
BEGIN
  Payload(cmd, 12, cmd_body)

  PopToken(cmd_body, token)
  CNV_STR_INT(token, reg_no)
  PopToken(cmd_body, token)
  CNV_STR_INT(token, move_type)

  POS_REG_TYPE(reg_no, 1, pos_type, num_axes, g_status)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_POS_TYPE_FAIL')
    RETURN
  ENDIF

  pos = GET_POS_REG(reg_no, g_status, 1)
  IF g_status <> 0 THEN
    WriteErr(ch, 'GET_POS_REG_FAIL')
    RETURN
  ENDIF

  CNV_CONF_STR(pos.config_data, cfg_text)
  WRITE ch('POSVAR:',
           reg_no, ',',
           pos_type, ',',
           num_axes, ',',
           pos.x::10::3, ',',
           pos.y::10::3, ',',
           pos.z::10::3, ',',
           pos.w::10::3, ',',
           pos.p::10::3, ',',
           pos.r::10::3, ',',
           cfg_text, CR)
END DoGetPosVar

ROUTINE DispatchCommand(ch : FILE; cmd : STRING)
BEGIN
  IF cmd = 'HELLO' THEN
    WriteOk(ch, 'READY')
    RETURN
  ENDIF

  IF cmd = 'CHECK_DONE' THEN
    WriteDoneState(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_POS' THEN
    WriteCurrentPos(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_POS_00' THEN
    WriteCurrentPos00(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_POS_001' THEN
    WriteCurrentPos001(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_POS_01' THEN
    WriteCurrentPos01(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_POS_10' THEN
    WriteCurrentPos10(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_POS_11' THEN
    WriteCurrentPos11(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_POS_011' THEN
    WriteCurrentPos011(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_POS_111' THEN
    WriteCurrentPos111(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_CUR_PULSE' THEN
    WriteCurrentPulse(ch, 6)
    RETURN
  ENDIF
  IF SUB_STR(cmd, 1, 14) = 'GET_CUR_PULSE:' THEN
    Payload(cmd, 14, g_text1)
    CNV_STR_INT(g_text1, g_int)
    WriteCurrentPulse(ch, g_int)
    RETURN
  ENDIF
  IF cmd = 'GET_USER_PROGRAM' THEN
    WRITE ch('PROGRAM:FANUC_RESIDENT_SERVICE;LIB=20260825_ADAPTOR_V3;',
             'ABORT_V2;PAUSE_V1;TOOL_DATA_V1;HAND_EYE_R100_V1', CR)
    RETURN
  ENDIF
  IF cmd = 'GET_USER_PROJECT' THEN
    WRITE ch('PROJECT:MD', CR)
    RETURN
  ENDIF
  IF SUB_STR(cmd, 1, 8) = 'SET_INT:' THEN
    DoSetInt(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd, 1, 8) = 'GET_INT:' THEN
    DoGetInt(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd, 1, 9) = 'CALL_JOB:' THEN
    DoCallJob(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd, 1, 13) = 'SET_TP_SPEED:' THEN
    DoSetTpSpeed(ch, cmd)
    RETURN
  ENDIF
  IF cmd = 'STOP_SERVICE' THEN
    DoStopService(ch)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,9) = 'SET_REAL:' THEN
    DoSetReal(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,12) = 'SET_POS_VAR:' THEN
    DoSetPosVar(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,12) = 'GET_POS_VAR:' THEN
    DoGetPosVar(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,10) = 'SET_SPEED:' THEN
    WriteErr(ch, 'SET_SPEED_UNSUPPORTED')
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,18) = 'LOAD_USER_PROGRAM:' THEN
    WriteErr(ch, 'LOAD_USER_PROGRAM_UNSUPPORTED')
    RETURN
  ENDIF
  IF cmd = 'UNLOAD_USER_PROGRAM' THEN
    WriteErr(ch, 'UNLOAD_USER_PROGRAM_UNSUPPORTED')
    RETURN
  ENDIF
  IF cmd = 'PROGRAM_START' THEN
    WriteErr(ch, 'PROGRAM_START_UNSUPPORTED')
    RETURN
  ENDIF
  IF cmd = 'PROGRAM_STOP' THEN
    DoProgramStop(ch)
    RETURN
  ENDIF
  IF cmd = 'GET_ACTIVE_TASK' THEN
    WriteActiveTask(ch)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,11) = 'PAUSE_TASK:' THEN
    DoPauseTask(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,12) = 'RESUME_TASK:' THEN
    DoResumeTask(ch, cmd)
    RETURN
  ENDIF
  IF cmd = 'SERVO_ON' THEN
    WriteErr(ch, 'SERVO_ON_UNSUPPORTED')
    RETURN
  ENDIF
  IF cmd = 'SERVO_OFF' THEN
    WriteErr(ch, 'SERVO_OFF_UNSUPPORTED')
    RETURN
  ENDIF
  IF cmd = 'CLEAR_ALARM' THEN
    WriteErr(ch, 'CLEAR_ALARM_UNSUPPORTED')
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,13) = 'SET_SYS_MODE:' THEN
    WriteErr(ch, 'SET_SYS_MODE_UNSUPPORTED')
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,12) = 'SET_TOOL_NO:' THEN
    DoSetToolNo(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,14) = 'GET_TOOL_DATA:' THEN
    DoGetToolData(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,14) = 'GET_HE_MATRIX:' THEN
    DoGetHandEyeMatrix(ch, cmd)
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,16) = 'AXIS_PULSE_MOVE:' THEN
    WriteErr(ch, 'AXIS_PULSE_MOVE_UNSUPPORTED')
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,9) = 'POS_MOVE:' THEN
    WriteErr(ch, 'POS_MOVE_UNSUPPORTED')
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,17) = 'MOVE_BY_JOB_AXIS:' THEN
    WriteErr(ch, 'MOVE_BY_JOB_AXIS_UNSUPPORTED')
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,16) = 'MOVE_BY_JOB_POS:' THEN
    WriteErr(ch, 'MOVE_BY_JOB_POS_UNSUPPORTED')
    RETURN
  ENDIF
  IF SUB_STR(cmd,1,19) = 'MOVE_BY_JOB_VECTOR:' THEN
    WriteErr(ch, 'MOVE_BY_JOB_VECTOR_UNSUPPORTED')
    RETURN
  ENDIF

  WriteErr(ch, 'UNKNOWN_CMD')
END DispatchCommand

BEGIN
END FANUC_SERVICE_LIB
